# Copy to .env and fill in real values:  cp .env.example .env

# ---- Database ----
# For docker compose: host MUST be "db" (the compose service name), not localhost.
DATABASE_URL=postgresql://myuser:root@db:5432/call_review_db
# These must match DATABASE_URL (used to init the postgres container):
POSTGRES_USER=myuser
POSTGRES_PASSWORD=root
POSTGRES_DB=call_review_db
# (For a non-docker / local run instead, use: postgresql://user:pass@localhost:5432/call_review_db)

# ---- App host port (compose maps APP_PORT -> container 8000) ----
APP_PORT=8000          # set to 8123 on servers where 8000 is taken

# ---- Gemini vendor ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ---- Groq vendor ----
GROQ_API_KEY=

# ---- Groq-vendor diarization + transcription ----
PYANNOTE_API_KEY=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# ---- Admin dashboard login (/admin) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# ---- AWS S3 (optional) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ---- Storage ----
AUDIO_STORAGE_DIR=audio_files
